{
  "schemaVersion": 1,
  "id": "peerlink",
  "version": "${version}",
  "name": "PeerLink",
  "description": "Multiplayer mod based on WebRTC",
  "authors": [
    "RTAkland"
  ],
  "contact": {
    "sources": "https://github.com/RTAkland/PeerLink"
  },
  "license": "Apache-2.0",
  "icon": "assets/template-mod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "value": "cn.rtast.peerlink.client.PeerLinkEntrypoint",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "peerlink.mixins.json"
  ],
  "accessWidener": "peerlink.accesswidener",
  "depends": {
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  }
