{
  "schemaVersion": 1,
  "id": "peerlink",
  "version": "${version}",
  "name": "PeerLink",
  "description": "Multiplayer mod based on WebRTC",
  "authors": [
    "RTAkland"
  ],
  "contact": {
    "sources": "https://github.com/RTAkland/PeerLink"
  },
  "license": "Apache-2.0",
  "icon": "assets/peerlink/textures/gui/sprites/icon/webrtc_multiplayer.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      {
        "value": "cn.rtast.peerlink.client.PeerLink",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "peerlink.mixins.json"
  ],
  "accessWidener": "peerlink.accesswidener",
  "depends": {
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  }
}